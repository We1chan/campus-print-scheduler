# Replace print.example.com and certificate paths with your own settings.
# Include inside nginx's http {} context (usually /etc/nginx/conf.d/).
## Many students may share a single campus Wi-Fi public IP.
limit_req_zone $binary_remote_addr zone=classroom_rate:10m rate=100r/s;
limit_conn_zone $binary_remote_addr zone=classroom_connections:10m;

server {
    listen 80;
    server_name print.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name print.example.com;
    ssl_certificate /etc/letsencrypt/live/print.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/print.example.com/privkey.pem;
    client_max_body_size 10m;
    client_body_timeout 15s;
    limit_req zone=classroom_rate burst=200 nodelay;
    limit_req_status 429;
    limit_conn classroom_connections 128;
    # Join codes appear in URLs: avoid recording them in access logs.
    access_log off;

    location / {
        # This port exists on the ECS only while the laptop's ssh -R runs.
        proxy_pass http://127.0.0.1:18787;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_request_buffering on;
    }
}
